# ==============================
# Report Runtime Configuration
# ==============================

# Delivery mode: github_pages | slack_file | telegram | telegram_channel | local_only | composite
DELIVERY_MODE=local_only

# For composite mode, comma separated
COMPOSITE_MODES=local_only

# ==============================
# Analysis thresholds (optional)
# ==============================
ANALYSIS_MIN_CHANGE=5.0
ANALYSIS_MIN_VALUE=100000000000
ANALYSIS_MIN_MCAP=500000000000
ANALYSIS_MAX_FROM_LOW=300.0
ANALYSIS_EPS=1e-6
ANALYSIS_LOOKBACK_52W_DAYS=365
ANALYSIS_LOOKBACK_PATTERN_DAYS=40

# ==============================
# GitHub Pages (optional)
# ==============================
# Default is current project path if empty
GITHUB_LOCAL_REPO_PATH=
GITHUB_USERNAME=
GITHUB_REPO=

# ==============================
# Slack (optional)
# ==============================
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ==============================
# Telegram (optional)
# ==============================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=bot
TELEGRAM_SEND_PREVIEW=true
TELEGRAM_SEND_AS_FILE=true
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_FILE_SIZE_LIMIT_MB=45

# ==============================
# Local output
# ==============================
LOCAL_OUTPUT_DIR=.
LOCAL_OPEN_BROWSER=false
