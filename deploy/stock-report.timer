[Unit]
Description=평일 장 마감 후 주식 리포트 실행 (KRX 정규장 마감 15:30 KST)
Documentation=https://github.com/jkkim74/stock-report

[Timer]
# 타임존을 명시하므로 VM 시스템 타임존을 바꾸지 않아도 된다.
# (OnCalendar의 타임존 접미사는 systemd 247+ 필요 - 배포 스크립트에서 검증한다)
OnCalendar=Mon-Fri 15:40 Asia/Seoul

# VM 재부팅 등으로 실행 시각을 놓쳤으면 부팅 후 따라잡는다.
Persistent=true

Unit=stock-report.service

[Install]
WantedBy=timers.target
